# Generated by ./generate-xsession.sh. Package path is filled in automatically.
{ pkgs, ... }:
let
  # This is the LHWM derivation built by the generator. Keeping it as a
  # store-path value makes Nix retain the executable in the system closure.
  # Keep this as a string, not a Nix path literal. The generated store path is
  # discovered at runtime by the generator and is not a flake input. Nix's
  # pure evaluator rejects it as a path literal. Store references embedded in
  # the runner script are still detected and retained in the system closure.
  lhwmPackage = "@LHWM_PACKAGE@";

  # Give LightDM a predictable X11 session launcher. The config shipped with
  # LHWM remains the fallback; ~/.config/lhwm/lhwm.conf can override it.
  lhwmRunner = pkgs.writeShellScriptBin "lhwm-session" ''
    export XDG_SESSION_TYPE=x11
    export XDG_SESSION_DESKTOP=lhwm
    export XDG_CURRENT_DESKTOP=LHWM
    export DESKTOP_SESSION=lhwm
    export LHWM_DEFAULT_CONFIG="${lhwmPackage}/share/lhwm/lhwm.conf"

    if command -v dbus-run-session >/dev/null 2>&1; then
      dbus-run-session -- "${lhwmPackage}/bin/lhwm" "$@"
      status=$?
    else
      "${lhwmPackage}/bin/lhwm" "$@"
      status=$?
    fi
    exit "$status"
  '';

  lhwmSession = (pkgs.runCommand "lhwm-session" { } ''
    mkdir -p "$out/share/xsessions"
    cat > "$out/share/xsessions/lhwm.desktop" <<EOF_SESSION
[Desktop Entry]
Name=LHWM
Comment=Lightweight HolyWM X11 window manager
Exec=${lhwmRunner}/bin/lhwm-session
TryExec=${lhwmPackage}/bin/lhwm
Type=XSession
DesktopNames=LHWM
EOF_SESSION
  '') // {
    providedSessions = [ "lhwm" ];
  };
in
{
  services.displayManager.sessionPackages = [ lhwmSession ];
  # dmenu_run is the default Mod4+d command; the bitmap font provides the
  # X11 "fixed" core font used by the tiny in-process topbar.
  environment.systemPackages = [ lhwmRunner pkgs.dmenu ];
  fonts.packages = [ pkgs.font-misc-misc ];
}
