#!/bin/sh
# Session entry wrapper generated by make install.
export XDG_SESSION_TYPE=x11
export XDG_SESSION_DESKTOP=lhwm
export XDG_CURRENT_DESKTOP=lhwm

if [ -z "${LHWM_DEFAULT_CONFIG:-}" ] && [ -n "@DEFAULT_CONFIG@" ]; then
    LHWM_DEFAULT_CONFIG="@DEFAULT_CONFIG@"
fi
export LHWM_DEFAULT_CONFIG

if command -v dbus-run-session >/dev/null 2>&1; then
    dbus-run-session -- "@BINDIR@/lhwm"
    STATUS=$?
else
    "@BINDIR@/lhwm"
    STATUS=$?
fi
exit "$STATUS"
